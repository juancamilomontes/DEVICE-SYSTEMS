# Copia este archivo como .env y coloca tus valores reales.
# El .env NUNCA se sube a git (contiene secretos).

# Clave para firmar los tokens JWT. Usa una cadena larga y aleatoria.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-secreta

# Algoritmo de firma del JWT.
ALGORITHM=HS256

# Minutos de validez del token de acceso.
ACCESS_TOKEN_EXPIRE_MINUTES=60
